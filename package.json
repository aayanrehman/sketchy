{
  "name": "sketchy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sketchy: a drawing imposter party game with an AI judge.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --import tsx --watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "NODE_ENV=production node --import tsx server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p convex/tsconfig.json --noEmit",
    "test": "node --import tsx --test server/src/*.test.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "verify:browser": "node --import tsx scripts/browser-verify.ts",
    "eval:prepare": "node --import tsx scripts/ai-eval.ts prepare",
    "eval:run": "node --import tsx scripts/ai-eval.ts run",
    "ai:smoke": "node --import tsx scripts/live-smoke.ts",
    "deploy": "npx convex deploy -y && vercel deploy --prod --yes --build-env VITE_CONVEX_URL=https://curious-chickadee-740.convex.cloud",
    "smoke:mp": "node --import tsx scripts/mp-smoke.ts"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "convex": "^1.46.0",
    "dotenv": "^18.0.6",
    "express": "^4.21.2",
    "framer-motion": "^11.15.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
