# Server-only secrets. Never shipped to the browser.
OPENAI_API_KEY=
# openai | mock | off   (defaults to openai when a key is set, otherwise mock)
AI_MODE=
# Cheapest current OpenAI image model that supports /v1/images/edits. Verify before launch.
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=low
# Vision-capable chat model for the judge.
OPENAI_JUDGE_MODEL=gpt-4.1-mini
# Force fallbacks for testing: comma list of glow,judge,safety,cap
AI_FORCE_FAIL=
# Optional: protects the hidden /studio save endpoint
STUDIO_KEY=
PORT=3000
