# Server-only. npm run setup:local opens a loopback-only masked key form.
# fal is the selected provider. Set AI_MODE=fal after private setup.
FAL_KEY=
# Optional direct OpenAI provider:
OPENAI_API_KEY=
AI_MODE=mock
# Live calls require this explicit switch, a key, and available persistent budget.
LIVE_AI_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=low
OPENAI_JUDGE_MODEL=gpt-4.1-mini
# Optional separate OpenAI-compatible judge (unverified until evaluated).
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=
# Hard request caps per UTC day, each for images and ratings, all rooms combined.
# Reservations persist on disk. This is not an exact dollar billing cap.
AI_DAILY_JOB_LIMIT=48
AI_CONCURRENCY=8
# Defaults beside MEDIA_DIR; keep on the same persistent disk.
AI_BUDGET_FILE=
# Required for studio/proof in every environment. Never publish this secret.
STUDIO_KEY=
AI_FORCE_FAIL=
ENABLE_DEBUG=false
PORT=3000
MAX_ROOMS=100
MEDIA_DIR=server/data/media
# Generated images expire after 30 days; download cards to keep them.
MEDIA_MAX_BYTES=500000000
